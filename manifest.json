		{
			"name": "Minimal",
			"tooltip": "Hides a bunch of unnecessary or redundant text in prompts for an even more minimal UI experience",
			"group": "Minimal Prompt Text",
			"type": "select",
			"localisationOverrides": {
				"008C4B8D68BA3D1E": {
