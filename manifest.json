{
	"version": "3.4.0",
	"updateCheck": "https://github.com/charc0al/HitmanCleanUI/releases/latest/download/updates.json",
	"id": "Charc0al.MinimalistUI",
	"name": "Minimalist HUD",
	"description": "Removes unnecessary HUD clutter that can't be disabled via the menu.",
	"authors": ["Charc0al", "Burn, the witch"],
	"frameworkVersion": "2.33.26",
	"loadAfter": ["BurnTheWitch.HeritageUI"],
	"options": [
		{
			"name": "Vanilla (no changes)",
			"tooltip": "Vanilla UI version",
			"group": "HUD",
			"image": "smf/vanilla.webp",
			"type": "select"
		},
		{
			"name": "Minimalist | Vanilla UI (normal crosshair)",
			"tooltip": "Vanilla UI version - crosshair unchanged",
			"group": "HUD",
			"type": "select",
			"image": "smf/minimal.webp",
			"contentFolders": ["content/minhud_vanilla"]
		},
		{
			"name": "Minimalist | HeritageUI (dot crosshair 50% transparent)",
			"tooltip": "Minimalist HUD - HeritageUI compatible version",
			"group": "HUD",
			"type": "select",
			"image": "smf/heritage.webp",
			"contentFolders": ["content/minhud_heritage"]
		},
		{
			"name": "Minimalist | DEFINITIVE EDITION",
			"tooltip": "Minimalist HUD - The definitive edition of this mod. All the base changes of this mod built on top of Heritage UI hud. Dot crosshair no transparency. I've changed some of the freelancer icons back to green, the SA indicator his hidden when green, and the best part - customizeable action prompts. You can edit the manifest.json to decide for a bunch of different prompts if you want to hide the button, the top text, or both from the interaction hud.",
			"group": "HUD",
			"type": "select",
			"enabledByDefault": true,
			"image": "smf/definitive.webp",
			"contentFolders": ["content/minhud_charc0al"]
		},
		{
			"name": "Throw | Dot Reticle",
			"tooltip": "Changes the thrown object reticle into a dot",
			"group": "Throw",
			"type": "checkbox",
			"image": "smf/throw.webp",
			"enabledByDefault": true,
			"contentFolders": ["content/throw_target"]
		},
		{
			"name": "Throw | Hide Arc",
			"tooltip": "Hides the 3D throw arc",
			"group": "Throw",
			"type": "checkbox",
			"image": "smf/throwarc.webp",
			"enabledByDefault": true,
			"contentFolders": ["content/throw_arc"]
		},
		{
			"name": "Throw | Hide Impact",
			"tooltip": "Hides the throw aiming landing circle animation",
			"group": "Throw",
			"type": "checkbox",
			"image": "smf/throwimpact.webp",
			"contentFolders": ["content/throw_impact"]
		},
		{
			"name": "Remove Exit Icon from HUD",
			"tooltip": "Remove Exit Icon",
			"group": "Other",
			"type": "checkbox",
			"image": "smf/exit.webp",
			"enabledByDefault": true,
			"contentFolders": ["content/hide_exit_icon"]
		},
		{
			"name": "Hide Passport icon (Safehouse)",
			"tooltip": "Remove Passport icon from the freelancer safehouse",
			"group": "Other",
			"type": "checkbox",
			"enabledByDefault": false,
			"contentFolders": ["content/hide_passport"]
		},
		{
			"name": "Hide Interaction Outline",
			"tooltip": "Hides the white outline including around NPCs. In-game menu option only affects items.",
			"group": "Other",
			"type": "checkbox",
			"enabledByDefault": true,
			"image": "smf/npc_interaction.webp",
			"contentFolders": ["content/npc_interact"]
		},
		{
			"name": "Hide Suspect Phone Fx",
			"tooltip": "Removes the pulsing circle and camera filter from the freelancer suspect burner phones.",
			"group": "Other",
			"type": "checkbox",
			"enabledByDefault": true,
			"image": "smf/phonefx.webp",
			"contentFolders": ["content/phonefx"]
		},
		{
			"name": "Minimal Instinct",
			"tooltip": "No instinct filter, no outlines, more faint NPC highlights",
			"group": "Other",
			"type": "checkbox",
			"image": "smf/instinct.webp",
			"enabledByDefault": true,
			"contentFolders": ["content/minimal_instinct"]
		},
		{
			"name": "Hide Skeleton",
			"tooltip": "Hides the cartoonish skeleton showing when people get electrocuted. Like HM2016",
			"group": "Other",
			"type": "checkbox",
			"image": "smf/skeletor.webp",
			"enabledByDefault": true,
			"contentFolders": ["content/skeleton"]
		},
		{
			"name": "Fix - stadia icons",
			"tooltip": "Check this box ONLY IF you're not using Heritage UI AND have hide exit icon unchecked",
			"group": "Other",
			"type": "checkbox",
			"enabledByDefault": false,
			"contentFolders": ["content/heritagefix"]
		},
		{
			"name": "Vanilla - No changes",
			"tooltip": "No changes to prompt text",
			"group": "DEFINITIVE EDITION | Minimal Prompt Text",
			"type": "select",
			"enabledByDefault": true
		},
